# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# DS Store
*.DS_Store

# Simulation / fit artifacts (regenerable)
outputs/*.rds

# Smoke-test outputs (tests/smoke.R)
outputs/smoke/

# Stan compile artifacts — cmdstanr writes a compiled binary and a
# generated .hpp header next to each .stan source. Whitelist only the
# sources (including stan/include/) so any future artifact types stay out.
stan/**
!stan/**/
!stan/**/*.stan

# Raw MURI inputs that stay private (this repo is public). Only the real-data
# loader (R/01_load_muri.r) and R/02_check_muri.r read them; copy them to a
# new clone by hand (notes/stats3_guide.md, Part 4). The derived
# data/processed/muri_{edna,visual}.rds and the qPCR, effort and sightings
# files are tracked.
data/MV1_MURI_df.csv
data/SITEINFO_CCE_2018_Pp_Lo_Mn.csv
data/obis_seamap_dataset_*/

# Claude Code worktrees
.claude/worktrees/

# Visual-model fits and validation (R/fit_visual.r, R/validate_visual.r)
outputs/visual/

# Joint-simulator validation (R/validate_joint_sim.r)
outputs/joint_sim/

# Joint-model comparison fits (R/compare_joint.r)
outputs/joint/

# Job logs from tools/stats3_reruns.sh
logs/
